MEMORY        			/* set up memory for sdb board */
{
 SCRATCH	: org = 0x01000000,	len = 0x138000
 ROM0		: org = 0xFF800000,	len = 0x1000
 ROM1		: org = 0xFF801000,	len = 0x1000
 ROM2		: org = 0xFF804000,	len = 0x4F8000
/* Revolution X advertisement is in main roms and 0x76E5 long	*/
/* But i don't know how to link it raw in there yet.		*/
 ROMX		: org = 0xFFD00000,	len = 0x8000
 ROM3		: org = 0xFFFF6F00,	len = 0x8D00
 TRAP31		: org = 0xFFFFFC00,	len = 0x400
 IROM		: org = 0x02000000,	len = 0x600000
}

SECTIONS       /* linker sections directive */
 {
	VECTORS:  {} 	> TRAP31
	IMAGES:   {}    > IROM
	GROUP:
	      {
		unzip: {}
		OFIXED: {}
	       .BSS: {}
	       .bss: {}
	      } > SCRATCH

	GROUP:
	      {	
	       FLOORORG: {}
	      } > ROM0

	GROUP:
	      {	
	       SHADORG: {}
	      } > ROM1

	GROUP:
	      {	
	       .text: {}
	       .TEXT: {}
	       .data: {}
	       .DATA: {}
		img_tbl: {}
	      } > ROM2	

 }