/*	Game linker command file				*/
-e POWERUP		/* entry point of program		*/
-f 0xFFFF		/* fill unspecified memory with value	*/
-o MK2P.OUT		/* specify output file			*/
-m MK2P.MAP		/* map file				*/
-s			/* Kill the symbol table		*/

/* Restructured link order! 					*/
/* From tracing MK2 3.0 production code. 			*/
/* RAM.OBJ was matched with code at FF804000 f_skew		*/

MKDISP.OBJ		/* FF804000 IMAGE HANDLER		*/
RAM.obj			/* MEMORY 				*/ 
/* has to be linked in this order, otherwise bss wrong. 	*/
/* in this order variables match up with production code. 	*/
BAKGND.OBJ		/* FF80AB60 background handlers 	*/
BGNDPAL.OBJ		/* no .text section in this - BACKGROUND TABLES */
BGNDTBL.OBJ		/* no .text section in this - BACKGROUND PALETTES */
PALL.OBJ 		/* FF80C610 - PALETTE ROUTINES		*/
MPROC.OBJ               /* FF80DAE0 - MULTI-TASKER		*/ 
/* if we link mproc before ram, it fucks up ram area from ram.obj.. */
UTIL.OBJ		/* FF80E760 - UTILITIES		*/
MKINIT.OBJ		/* FF810F80 - INITIALIZATION AND INTERRUPTS */
MAIN.OBJ 		/* FF8176E0 - MAIN GAME LOOP		*/
/* PRODUCTION HAS SOME CODE HERE THAT WE ARE MISSING */
MKBUYIN.OBJ 		/* FF82B820 - BUYIN CODE 		*/
JOY.OBJ			/* FF82EDC0 - ANIMATION ROUTINES+TABLES */
mkutil.obj 		/* FF8380D0 - UTILITIES			*/
MKAMODE.OBJ		/* FF843030 - ATTRACT MODE SCRIPT	*/
MKEND.obj		/* FF853530 - ENDING CONGRATS		*/
mkfall.obj 		/* FF85BB20 - FALLING INTO PIT 		*/
PONG.OBJ		/* FF87B8F0 - THAT GAME 		*/
MKBABY.OBJ		/* FF87E120 - BABALITY			*/
mkfriend.obj 		/* FF880770 - FRIENDSHIPS 		*/
mkprop.obj		/* FF888D50 - BODY PROPELL MOVES 	*/
