+TIMER_CALLBACK_MEMBER(midtunit_state::mk2ks_battle_audio_tick)
+{
+	// TMS34010 program-space addresses are bits (including read_word).
+	// Read exactly the original physical actor/Main/health publications.
+	auto &space = m_maincpu->space(AS_PROGRAM);
+	auto const read32 = [&space](uint32_t at) {
+		return uint32_t(space.read_word(at)) | (uint32_t(space.read_word(at + 16)) << 16);
+	};
+	uint32_t const actors[2] = { 0x01060220, 0x01060df0 };
+	uint32_t const mains[2] = { 0x01060260, 0x01060e30 };
+	uint32_t const health[2] = { 0x010602f0, 0x01060ec0 };
+	for (unsigned slot = 0; slot < 2; slot++)
+	{
+		uint32_t const actor = m_mk2ks_battle_actor[slot];
+		uint32_t const main = m_mk2ks_battle_main[slot];
+		if (!actor) continue;
+		uint16_t const mode = space.read_word(0x010601d0);
+		if ((mode != 1 && mode != 2) || mode != m_mk2ks_battle_mode[slot] ||
+			(mode == 1 && space.read_word(0x01061990) != 0))
+			mk2ks_battle_audio_stop(slot, "noncombat");
+		else if (read32(actors[slot]) != actor || read32(mains[slot]) != main ||
+			read32(main + 0xc0) != actor || space.read_word(actor + 0x1f0) != m_mk2ks_battle_id[slot])
+			mk2ks_battle_audio_stop(slot, "owner_changed");
+		else if (space.read_word(health[slot]) != m_mk2ks_battle_health[slot])
