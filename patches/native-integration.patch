+void midtunit_state::mk2ks_battle_audio_stop(unsigned slot, const char *reason)
+{
+	if (m_mk2ks_battle_actor[slot])
+		logerror("MK2KS_BATTLE_CLEANUP slot=%u actor=%08X main=%08X reason=%s seconds=%.12f\n",
+			slot + 1, m_mk2ks_battle_actor[slot], m_mk2ks_battle_main[slot], reason, machine().time().as_double());
+	if (m_mk2ks_voices)
+	{
+		m_mk2ks_voices->stop(10 + slot * 2);
+		m_mk2ks_voices->stop(11 + slot * 2);
+	}
+	m_mk2ks_battle_actor[slot] = 0;
+	m_mk2ks_battle_main[slot] = 0;
+	m_mk2ks_battle_health[slot] = 0;
+	m_mk2ks_battle_id[slot] = 0;
+	m_mk2ks_battle_mode[slot] = 0;
+	// Silent selection, attract and gameplay need no extra scheduler callbacks.
+	// Keep checking when the other physical player's launch is still owned.
+	if (m_mk2ks_battle_audio_timer && !m_mk2ks_battle_actor[0] && !m_mk2ks_battle_actor[1])
