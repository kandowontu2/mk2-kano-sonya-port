+			space.read_word(owner+0x1f0)!=17 || space.read_word(rosters[slot])!=17 ||
+			read32(owner_main+0xc0)!=owner || read32(victim_main+0xc0)!=victim ||
+			space.read_word(health[1-slot])!=0 || !space.read_word(health[slot])) continue;
