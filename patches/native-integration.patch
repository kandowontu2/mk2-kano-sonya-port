+void midtunit_state::mk2ks(machine_config &config)
+{
+	tunit_dcs(config);
+	SPEAKER(config, "mk2ksvoice").front_center();
+	SAMPLES(config, m_mk2ks_voices);
+	// Original MK3 chicken commands select one of five independent voices.
+	// Keep these separate from announcements/fatalities and the bubble pop.
+	// Two additional channels per physical player keep both simultaneous
+	// bicycle launch cues independent from the opponent and announcements.
+	m_mk2ks_voices->set_channels(19);
+	m_mk2ks_voices->set_samples_names(mk2ks_voice_names);
+	m_mk2ks_voices->add_route(ALL_OUTPUTS, "mk2ksvoice", 0.70);
+	m_palette->set_entries(0x8300);
+	m_maincpu->set_addrmap(AS_PROGRAM, &midtunit_state::mk2ks_map);
+	subdevice<screen_device>("screen")->screen_vblank().set(FUNC(midtunit_state::mk2ks_finish_audio_frame));
+}
