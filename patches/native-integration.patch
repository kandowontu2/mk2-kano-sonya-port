+	unsigned const slot=m_mk2ks_finish_audio_slot;
+	if (slot>=2) { mk2ks_finish_audio_stop("invalid_audio_slot");return; }
+	if ((mode!=2 && mode!=5) || read32(actors[slot])!=m_mk2ks_finish_audio_actor ||
+		read32(mains[slot])!=m_mk2ks_finish_audio_main ||
+		read32(m_mk2ks_finish_audio_main+0xc0)!=m_mk2ks_finish_audio_actor ||
+		space.read_word(m_mk2ks_finish_audio_actor+0x1f0)!=17)
