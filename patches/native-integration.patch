+int midtunit_state::mk2ks_finish_audio_start(unsigned sample, uint16_t priority, uint16_t duration)
+{
+	// Whole original five-slot allocator: duplicate class3 rejection, class4
+	// same-voice replacement, first free slot, otherwise least priority.
+	int selected=-1;
+	if ((priority>>4)==3)
+		for (unsigned voice=0;voice<5;voice++)
+			if (m_mk2ks_finish_audio_priority[voice]==priority) return -1;
+	if ((priority>>4)==4)
+		for (unsigned voice=0;voice<5;voice++)
+			if (m_mk2ks_finish_audio_priority[voice]==priority) { selected=voice;break; }
+	if (selected<0)
+		for (unsigned voice=0;voice<5;voice++)
+			if (!m_mk2ks_finish_audio_priority[voice]) { selected=voice;break; }
+	if (selected<0)
+	{
+		selected=0;
+		for (unsigned voice=1;voice<5;voice++)
+			if (m_mk2ks_finish_audio_priority[voice]<m_mk2ks_finish_audio_priority[selected]) selected=voice;
+		if (m_mk2ks_finish_audio_priority[selected]>priority) return -1;
+	}
+	m_mk2ks_finish_audio_priority[selected]=priority;
+	m_mk2ks_finish_audio_remaining[selected]=duration;
+	m_mk2ks_voices->start(14 + selected,sample,false);
+	return selected;
+}
